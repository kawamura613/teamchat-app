{
  "permissions": {
    "deny": [
      "Edit(docs/spec.md)",
      "Edit(mockup/**)",
      "Read(.env)",
      "Edit(.env)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "allow": [
      "Bash(./vendor/bin/sail test)",
      "Bash(./vendor/bin/sail test *)",
      "Bash(./vendor/bin/sail artisan test)",
      "Bash(./vendor/bin/sail artisan test *)",
      "Bash(./vendor/bin/sail php vendor/bin/pint)",
      "Bash(./vendor/bin/sail php vendor/bin/pint *)",
      "Bash(sail test *)",
      "Bash(sail artisan test *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" 2>/dev/null || exit 0; [ -x ./vendor/bin/sail ] || exit 0; docker ps -q >/dev/null 2>&1 || exit 0; ./vendor/bin/sail php vendor/bin/pint --quiet >/dev/null 2>&1 || true",
            "timeout": 120,
            "onFailure": "continue",
            "statusMessage": "整形中..."
          }
        ]
      }
    ]
  }
}
